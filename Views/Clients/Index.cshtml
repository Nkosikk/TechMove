@model IReadOnlyCollection<Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Clients</h1>
        <p class="text-muted mb-0">Manage global logistics customers and their contact details.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add client</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No clients have been created yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Name</th><th>Contact details</th><th>Region</th><th>Contracts</th><th></th></tr></thead>
            <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Name</td>
                    <td>@client.ContactDetails</td>
                    <td>@client.Region</td>
                    <td>@client.Contracts.Count</td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
