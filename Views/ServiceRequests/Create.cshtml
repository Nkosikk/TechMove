@model ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "New service request";
}

<h1>New service request</h1>
<p class="text-muted">Enter the cost in USD. The current exchange rate will be retrieved and the ZAR value saved automatically.</p>
<form asp-action="Create" method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ContractId" class="form-label"></label>
        <select asp-for="ContractId" asp-items="ViewBag.Contracts" class="form-select">
            <option value="">Select an active or draft contract</option>
        </select>
        <span asp-validation-for="ContractId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CostUsd" class="form-label"></label>
        <div class="input-group"><span class="input-group-text">$</span><input asp-for="CostUsd" class="form-control" /></div>
        <span asp-validation-for="CostUsd" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create and convert</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
