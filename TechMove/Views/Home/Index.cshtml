@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="tm-hero mb-4">
    <div>
        <span class="tm-eyebrow">@(isAdmin ? "Control centre" : "My logistics workspace")</span>
        <h1 class="display-5">@(isAdmin ? "Operations & Approval Dashboard" : $"Welcome, {User.Identity?.Name}")</h1>
        <p class="col-lg-9 fs-5">@(isAdmin ? "Review pending work, monitor platform activity, and keep freight operations moving." : "Manage your clients, submit signed contracts for approval, and track service delivery from one secure workspace.")</p>
        <a asp-controller="Contracts" asp-action="Create" class="btn btn-primary btn-lg">Submit a contract</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="tm-stat"><span>Clients</span><strong>@Model.ClientCount</strong></div></div>
    <div class="col-6 col-lg"><div class="tm-stat"><span>Contracts</span><strong>@Model.ContractCount</strong></div></div>
    <div class="col-6 col-lg"><div class="tm-stat tm-stat-warning"><span>Pending contracts</span><strong>@Model.PendingContractCount</strong></div></div>
    <div class="col-6 col-lg"><div class="tm-stat"><span>Requests</span><strong>@Model.ServiceRequestCount</strong></div></div>
    @if (isAdmin)
    {
        <div class="col-6 col-lg"><div class="tm-stat tm-stat-accent"><span>Employees</span><strong>@Model.UserCount</strong></div></div>
        <div class="col-6 col-lg"><div class="tm-stat tm-stat-warning"><span>Pending employees</span><strong>@Model.PendingUserCount</strong></div></div>
    }
</div>

@if (isAdmin)
{
    <div class="card mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><span class="tm-eyebrow">Access control</span><h2 class="h4 mb-0 mt-1">Employee registrations awaiting approval</h2></div>
                <span class="badge text-bg-warning">@Model.PendingUserCount</span>
            </div>
            @if (Model.PendingUsers.Count == 0)
            {
                <p class="text-muted mb-0">No employee registrations are waiting for approval.</p>
            }
            @foreach (var pendingUser in Model.PendingUsers)
            {
                <div class="tm-queue-item">
                    <div class="tm-account-identity">
                        <span class="tm-avatar" aria-hidden="true"><span>@pendingUser.DisplayName[..1].ToUpperInvariant()</span><img src="@Url.Action("ManagedProfilePicture", "Account", new { id = pendingUser.Id })" alt="" onerror="this.remove()" /></span>
                        <div><strong>@pendingUser.DisplayName</strong><small>@pendingUser.Email · Registered @pendingUser.RegisteredAtUtc.ToLocalTime().ToString("g")</small></div>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-action="ApproveUser" method="post">
                            <input type="hidden" name="id" value="@pendingUser.Id" />
                            <button class="btn btn-sm btn-success">Approve account</button>
                        </form>
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editPending-@pendingUser.Id">Edit</button>
                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this employee account? This cannot be undone.');">
                            <input type="hidden" name="id" value="@pendingUser.Id" />
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
                <div class="modal fade" id="editPending-@pendingUser.Id" tabindex="-1" aria-labelledby="editPendingLabel-@pendingUser.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="UpdateUser" method="post">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5" id="editPendingLabel-@pendingUser.Id">Edit employee</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="id" value="@pendingUser.Id" />
                                    <div class="mb-3"><label class="form-label" for="pendingName-@pendingUser.Id">Display name</label><input class="form-control" id="pendingName-@pendingUser.Id" name="DisplayName" value="@pendingUser.DisplayName" required maxlength="100" /></div>
                                    <div><label class="form-label" for="pendingEmail-@pendingUser.Id">Email</label><input class="form-control" id="pendingEmail-@pendingUser.Id" name="Email" value="@pendingUser.Email" type="email" required maxlength="256" /></div>
                                </div>
                                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save changes</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><span class="tm-eyebrow">Role management</span><h2 class="h4 mb-0 mt-1">Approved employees and managers</h2></div>
                <span class="badge text-bg-info">@Model.Users.Count accounts</span>
            </div>
            @foreach (var managedUser in Model.Users)
            {
                <div class="tm-queue-item">
                    <div class="tm-account-identity">
                        <span class="tm-avatar" aria-hidden="true"><span>@managedUser.DisplayName[..1].ToUpperInvariant()</span><img src="@Url.Action("ManagedProfilePicture", "Account", new { id = managedUser.Id })" alt="" onerror="this.remove()" /></span>
                        <div><strong>@managedUser.DisplayName</strong><small>@managedUser.Email · @(managedUser.IsAdmin ? "Manager" : "Employee")</small></div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @if (managedUser.IsAdmin)
                        {
                            <span class="badge text-bg-success">Manager</span>
                        }
                        else
                        {
                            <form asp-action="PromoteUser" method="post">
                                <input type="hidden" name="id" value="@managedUser.Id" />
                                <button class="btn btn-sm btn-outline-primary">Make manager</button>
                            </form>
                        }
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editManaged-@managedUser.Id">Edit</button>
                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this @(managedUser.IsAdmin ? "manager" : "employee") account? This cannot be undone.');">
                            <input type="hidden" name="id" value="@managedUser.Id" />
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
                <div class="modal fade" id="editManaged-@managedUser.Id" tabindex="-1" aria-labelledby="editManagedLabel-@managedUser.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="UpdateUser" method="post">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5" id="editManagedLabel-@managedUser.Id">Edit @(managedUser.IsAdmin ? "manager" : "employee")</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="id" value="@managedUser.Id" />
                                    <div class="mb-3"><label class="form-label" for="managedName-@managedUser.Id">Display name</label><input class="form-control" id="managedName-@managedUser.Id" name="DisplayName" value="@managedUser.DisplayName" required maxlength="100" /></div>
                                    <div><label class="form-label" for="managedEmail-@managedUser.Id">Email</label><input class="form-control" id="managedEmail-@managedUser.Id" name="Email" value="@managedUser.Email" type="email" required maxlength="256" /></div>
                                </div>
                                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save changes</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">@(isAdmin ? "Contracts awaiting approval" : "My draft contracts")</h2><span class="badge text-bg-warning">@Model.PendingContractCount</span></div>
                @if (Model.PendingContracts.Count == 0) { <p class="text-muted">No contracts are waiting in the queue.</p> }
                @foreach (var contract in Model.PendingContracts)
                {
                    <div class="tm-queue-item">
                        <div><strong>@contract.Title</strong><small>@contract.ClientName · @contract.OwnerName</small></div>
                        @if (isAdmin)
                        {
                            <form asp-controller="Contracts" asp-action="Approve" method="post"><input type="hidden" name="id" value="@contract.Id" /><button class="btn btn-sm btn-success">Approve</button></form>
                        }
                        else
                        {
                            <a asp-controller="Contracts" asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-secondary">Review</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">@(isAdmin ? "Requests awaiting approval" : "My new requests")</h2><span class="badge text-bg-info">@Model.PendingServiceRequestCount</span></div>
                @if (Model.PendingServiceRequests.Count == 0) { <p class="text-muted">No service requests are waiting in the queue.</p> }
                @foreach (var request in Model.PendingServiceRequests)
                {
                    <div class="tm-queue-item">
                        <div><strong>@request.ContractTitle</strong><small>@request.Description · @request.OwnerName</small></div>
                        @if (isAdmin)
                        {
                            <form asp-controller="ServiceRequests" asp-action="Approve" method="post"><input type="hidden" name="id" value="@request.Id" /><button class="btn btn-sm btn-success">Approve</button></form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
