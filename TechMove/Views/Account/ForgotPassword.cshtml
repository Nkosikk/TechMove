@model ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot password";
}

<div class="tm-auth-shell">
    <form asp-action="ForgotPassword" method="post" class="card tm-auth-card mx-auto">
        <div class="card-body p-4 p-lg-5">
            <span class="tm-eyebrow">Account recovery</span>
            <h1 class="h2 mt-2">Reset your password</h1>
            <p class="text-muted">Enter your confirmed TechMove email address. If it matches an account, a secure reset link will be sent.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            <p class="text-center mt-4 mb-0"><a asp-action="Login">Return to sign in</a></p>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
