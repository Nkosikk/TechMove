@model ResetPasswordRequest
@{
    ViewData["Title"] = "Reset password";
}

<div class="tm-auth-shell">
    <form asp-action="ResetPassword" method="post" class="card tm-auth-card mx-auto">
        <div class="card-body p-4 p-lg-5">
            <span class="tm-eyebrow">Secure account recovery</span>
            <h1 class="h2 mt-2">Choose a new password</h1>
            <p class="text-muted">Create a strong new password for <strong>@Model.Email</strong>.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-text mb-4">Use at least 8 characters with uppercase, lowercase, a number, and a symbol.</div>
            <button type="submit" class="btn btn-primary w-100">Reset password</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
